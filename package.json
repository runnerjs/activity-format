{
  "name": "@runnerjs/activity-format",
  "version": "0.1.0",
  "description": "Parse and write FIT, GPX, and TCX activity files with a unified Activity model.",
  "author": "runnerjs",
  "license": "Apache-2.0",
  "homepage": "https://github.com/runnerjs/activity-format#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runnerjs/activity-format.git"
  },
  "bugs": {
    "url": "https://github.com/runnerjs/activity-format/issues"
  },
  "keywords": [
    "fit",
    "gpx",
    "tcx",
    "garmin",
    "activity",
    "gps",
    "track"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.15.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "pretest": "node ./scripts/bundle-fitsdk.cjs",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "prepublishOnly": "pnpm run typecheck && pnpm test",
    "prepack": "pnpm build",
    "test:package": "node scripts/test-package.mjs",
    "fixtures:generate": "node scripts/generate-fixtures.mjs"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.208.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/xml2js": "^0.4.14",
    "esbuild": "^0.27.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
